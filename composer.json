{
    "name": "zephora/logistics",
    "description": "WordPress plugin for logistics services with Ship For Me and Buy For Me workflows",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Zephora Engineering",
            "email": "support@zephora.logistics"
        }
    ],
    "require": {
        "php": ">=7.4",
        "dompdf/dompdf": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "ZLS\\": "includes/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=WordPress .",
        "lint-fix": "phpcbf --standard=WordPress ."
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "installer-paths": {
            "vendor/{$name}/": ["type:wordpress-plugin"]
        }
    }
}